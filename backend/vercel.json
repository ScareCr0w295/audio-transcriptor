{
  "version": 2,
  "builds": [
    {
      "src": "src/main.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/main.ts",
      "methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"]
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "API_URL": "https://audio-transcriptor-dmta.vercel.app",
    "CORS_ORIGINS": "https://audio-transcriptor-whpb.vercel.app"
  }
}